# ==============================================================================
# Environment Configuration Example — Ayo Maff Experience
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase PostgreSQL (Dual-mode fallback operates when omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Portal Authentication (Clerk or Fallback Admin Credentials)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=secure-admin-pass-hash
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Payment Gateway (Paystack for Nigerian Naira NGN & Global USD)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_sample
PAYSTACK_SECRET_KEY=sk_test_sample

# Analytics (Optional Privacy-Conscious Provider)
NEXT_PUBLIC_ANALYTICS_ID=

# Email Dispatcher (Resend / SendGrid / Postmark for Inquiries & Newsletters)
EMAIL_SERVER_API_KEY=
NOTIFICATION_EMAIL_RECIPIENT=management-concept@ayomaff.example
